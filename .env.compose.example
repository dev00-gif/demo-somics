# Full stack docker-compose.yml / Environment của service Compose trên Dokploy.
# Với broker đã có data, dùng password Dashboard HIỆN TẠI.
# Không dùng credential Dashboard của somics-mqtt.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# emqx-init tạo/cập nhật user MQTT app với password này.
MQTT_APP_USERNAME=web-backend
MQTT_APP_PASSWORD=

# Để rỗng khi chỉ dùng thiết bị SOMICS (credential riêng qua /api/iot/activate).
# Nếu cần user legacy MQTTX, đặt MQTT_DEVICE_USERS=device-01 device-02 và password.
MQTT_DEVICE_USERS=
MQTT_DEVICE_PASSWORD=

# Broker demo độc lập.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=18084
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=1883
MQTT_PUBLIC_TLS=false
MQTT_TOPIC_BASE=station/player
