# ===== MQTT Broker (EMQX trên VPS, deploy bằng Dokploy) =====
#
# LƯU Ý: file này dành cho app chạy ĐỘC LẬP (npm run dev, hoặc Dockerfile trên
# Dokploy). Full stack bằng docker-compose.yml ở root thì dùng file .env ở root
# (compose tự inject MQTT_URL vào app giúp bạn).

# --- Khi BE Next.js chạy TRONG Dokploy (cùng docker network "dokploy-network") ---
# Dùng alias nội bộ, không đi ra internet:
# MQTT_URL=mqtt://emqx:1883

# --- Khi BE chạy ngoài Docker / dev trên máy cá nhân ---
# Dùng IP/domain VPS (port 1883 phải được firewall cho phép):
MQTT_URL=mqtt://YOUR_VPS_IP:1883

# Tài khoản MQTT (phải khớp user trong deploy/emqx/emqx/auth-bootstrap.csv
# hoặc tạo thêm trong Dashboard → Access Control → Authentication)
MQTT_USERNAME=web-backend
MQTT_PASSWORD=CHANGE_ME_backend_password

MQTT_CLIENT_ID_PREFIX=web-uploader

# Gốc topic (FE/BE/nhúng phải dùng cùng một giá trị)
MQTT_TOPIC_BASE=station/player

# Domain public của app để thiết bị nhúng tải file từ URL nhận qua MQTT.
# Ví dụ: https://station.example.com
APP_PUBLIC_URL=http://demosomics-demosomics-ftbr2y-8656a8-45-252-248-184.sslip.io/

# ===== Kích hoạt thiết bị (Luồng mới) =====

# EMQX Management API — backend gọi để cấp user MQTT cho từng thiết bị.
# Trong Dokploy/compose dùng alias nội bộ; chạy dev ngoài Docker thì trỏ tới VPS.
# EMQX_API_URL=http://emqx:18083

# Credentials Dashboard EMQX (cùng giá trị với DASHBOARD_USERNAME/PASSWORD của compose)
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password

# Thông tin MQTT public trả cho thiết bị lúc kích hoạt
# (domain trỏ tới broker, port TLS 8883 — xem deploy/emqx/README.md mục 8)
MQTT_PUBLIC_HOST=mqtt.example.com
MQTT_PUBLIC_PORT=8883
MQTT_PUBLIC_TLS=true

# Thư mục lưu dữ liệu thiết bị (devices.json, activation-codes.json, tokens)
# DEVICE_DATA_DIR=./data
