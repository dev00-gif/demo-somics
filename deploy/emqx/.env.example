# ==============================================================================
# Biến môi trường cho EMQX (copy thành .env hoặc dán vào tab Environment của Dokploy)
# TẠO MẬT KHẨU MẠNH:  openssl rand -base64 24
# ==============================================================================

# ----- Image ------------------------------------------------------------------
# Ghim bản stable cụ thể để deploy tái lập được (xem https://hub.docker.com/_/emqx)
EMQX_VERSION=6.1.5
EMQX_CONTAINER_NAME=emqx

# ----- Node (KHÔNG đổi sau khi đã chạy production — data gắn với node name) ---
EMQX_NODE_HOST=node1.emqx.local
# Cookie Erlang — chuỗi ngẫu nhiên bất kỳ, dùng khi mở rộng cluster
EMQX_NODE_COOKIE=CHANGE_ME_random_string_openssl_rand_base64_24

# ----- EMQX Dashboard (web quản trị :18083) -----------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_strong_password

# ----- Log level: emergency | alert | critical | error | warning | notice | info
EMQX_LOG_LEVEL=warning

# ----- Giới hạn RAM cho container ---------------------------------------------
EMQX_MEM_LIMIT=1g

# ===== PORT BINDING ===========================================================
# MQTT TCP: mở cho bên ngoài (thiết bị nhúng kết nối).
#   - Mặc định: mở cho mọi IP. Nên dùng firewall (ufw) chỉ cho phép IP cần thiết.
#   - Nếu chỉ có BE (chạy cùng Dokploy) kết nối: đặt MQTT_TCP_BIND=127.0.0.1
#   - Khuyến nghị: đóng 1883 với internet, chỉ mở 8883 (TLS) — xem README mục TLS.
MQTT_TCP_BIND=0.0.0.0

# MQTT TLS (8883): bind cho thiết bị nhúng kết nối encrypt.
# Trước khi start phải tạo chứng chỉ: cd certs && ./gen-certs.sh <domain-hoặc-IP>
MQTT_TLS_BIND=0.0.0.0

# Dashboard: CHỈ bind vào localhost — không lộ ra public.
# Truy cập qua SSH tunnel (xem README) hoặc gắn domain HTTPS qua Dokploy.
DASHBOARD_BIND=127.0.0.1
